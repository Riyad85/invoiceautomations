    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const type = $('Get Document').first().json.file_type;\nconst mimeMap = { pdf: 'application/pdf', jpg: 'image/jpeg', png: 'image/png', tiff: 'image/png' };\nconst buf = await this.helpers.getBinaryDataBuffer($itemIndex, 'data');\nreturn { json: { mime: mimeMap[type] || 'image/png', b64: buf.toString('base64'), size_kb: Math.round(buf.length / 1024) } };"
      },
      "name": "Prepare Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1104,
        208
      ],
      "id": "cd8e6f55-181a-4fca-ad5c-4993db2f055d"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [{ parts: [ { text: `You are an OCR engine. Transcribe ALL text visible in this document exactly as printed, in reading order.\\nRules:\\n1) Do not summarise, translate, correct or add anything.\\n2) Keep tables as one row per line with columns separated by ' | '.\\n3) If a character, word or number cannot be read with confidence, write [illegible] in its place. NEVER guess digits.\\n4) For multi-page documents start each page with a line like --- PAGE 1 ---.\\n5) If the document has no readable text at all, output exactly: NO_READABLE_TEXT\\nOutput only the transcription, no comments.` }, { inline_data: { mime_type: $json.mime, data: $json.b64 } } ] }], generationConfig: { temperature: 0 } }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "name": "Gemini OCR",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1328,
        208
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "id": "5d896bbe-deb6-4abd-b149-33b775ae732a",
      "credentials": {
        "httpHeaderAuth": {
          "id": "3pO6PyE35Z0g2wpt",
          "name": "gemini api"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const cand = ($json.candidates || [])[0] || {};\nconst parts = (cand.content && cand.content.parts) || [];\nconst text = parts.map(p => p.text || '').join('\\n').trim();\nconst reason = cand.finishReason || ($json.promptFeedback && $json.promptFeedback.blockReason) || 'unknown';\nif (!text) return { json: { ok: false, message: 'OCR returned no text (reason: ' + reason + ')' } };\nif (text === 'NO_READABLE_TEXT') return { json: { ok: false, message: 'No readable text found (image blank or too poor quality)' } };\nreturn { json: { ok: true, text, chars: text.length, illegible: (text.match(/\\[illegible\\]/g) || []).length } };"
      },
      "name": "Parse OCR",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [

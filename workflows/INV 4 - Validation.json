    {
      "parameters": {
        "jsCode": "const doc = $('Get Document').first().json;\nconst inv = $('Get Invoice').first().json || {};\nconst items = $('Get Line Items').all().map(i => i.json).filter(r => r && r.id);\nconst dups = $input.all().map(i => i.json).filter(r => r && r.id);\nconst errors = [];\nconst TOL = 0.011;               // rounding tolerance (0.01)\nconst LOW_CONF = 0.6;            // below this the value is sent to manual review\nconst add = (field, rule, severity, message) => errors.push({\n  document_id: doc.id, invoice_id: inv.id || null, field, code: rule.toUpperCase(), severity, message });\nconst n = v => (v === null || v === undefined || v === '') ? null : Number(v);\nconst bad = v => v !== null && !Number.isFinite(v);\n\nif (!inv.id) {\n  add('invoice', 'no_extraction', 'error', 'No extracted invoice data found for this document');\n} else {\n  // 1. Missing fields\n  const required = ['invoice_number', 'invoice_date', 'supplier_name', 'customer_name', 'total'];\n  const optional = ['subtotal', 'tax', 'currency'];\n  for (const f of required) if (inv[f] === null || inv[f] === undefined || inv[f] === '')\n    add(f, 'missing_field', 'error', 'Required field is missing: ' + f);\n  for (const f of optional) if (inv[f] === null || inv[f] === undefined || inv[f] === '')\n    add(f, 'missing_field', 'warning', 'Field is missing: ' + f);\n  if (items.length === 0) add('line_items', 'no_line_items', 'warning', 'No line items were extracted');\n\n  // 2. Numbers: valid and not negative\n  const sub = n(inv.subtotal), tax = n(inv.tax), tot = n(inv.total);\n  for (const [f, v] of [['subtotal', sub], ['tax', tax], ['total', tot]]) {\n    if (bad(v)) add(f, 'not_a_number', 'error', f + ' is not a valid number');\n    else if (v !== null && v < 0) add(f, 'negative_value', 'error', f + ' is negative: ' + v);\n  }\n  if (tot !== null && !bad(tot) && tot === 0) add('total', 'zero_total', 'warning', 'Total is zero');\n\n  // 3. subtotal + tax = total\n  if (sub !== null && tax !== null && tot !== null && ![sub, tax, tot].some(bad)) {\n    if (Math.abs(sub + tax - tot) > TOL)\n      add('total', 'total_mismatch', 'error',\n        'Subtotal ' + sub + ' + tax ' + tax + ' = ' + (Math.round((sub + tax) * 100) / 100) + ', but total is ' + tot);\n  }\n\n  // 4. line items: qty x price = line total, and sum of lines = subtotal\n  let sum = 0, counted = 0;\n  items.forEach((it, idx) => {\n    const q = n(it.quantity), p = n(it.unit_price), lt = n(it.line_total);\n    const label = 'Line ' + (it.position || idx + 1);\n    if ([q, p, lt].some(bad)) { add('line_items', 'not_a_number', 'error', label + ' has a non-numeric value'); return; }\n    if ((q !== null && q < 0) || (p !== null && p < 0) || (lt !== null && lt < 0))\n      add('line_items', 'negative_value', 'error', label + ' has a negative value');\n    if (q !== null && p !== null && lt !== null && Math.abs(q * p - lt) > TOL)\n      add('line_items', 'line_total_mismatch', 'error',\n        label + ': ' + q + ' x ' + p + ' = ' + (Math.round(q * p * 100) / 100) + ', but line total is ' + lt);\n    if (lt !== null) { sum += lt; counted++; }\n  });\n  if (counted > 0 && sub !== null && !bad(sub) && Math.abs(sum - sub) > TOL)\n    add('subtotal', 'line_sum_mismatch', 'error',\n      'Line items add up to ' + (Math.round(sum * 100) / 100) + ', but subtotal is ' + sub);\n\n  // 5. Duplicate invoice (same invoice number + same supplier in another document)\n  const norm = s => (s || '').toString().toLowerCase().replace(/[^a-z0-9]/g, '');\n  if (inv.invoice_number && inv.supplier_name) {\n    const same = dups.filter(d => norm(d.supplier_name) === norm(inv.supplier_name) && new Date(d.created_at) < new Date(inv.created_at));\n    if (same.length > 0)\n      add('invoice_number', 'duplicate_invoice', 'error',\n        'Same invoice number and supplier already exist in document ' + same[0].document_id);\n  }\n\n  // 6. Low model confidence\n  const conf = inv.confidence || {};\n  for (const f of required.concat(optional)) {\n    const c = Number(conf[f]);\n    if (inv[f] !== null && inv[f] !== undefined && Number.isFinite(c) && c < LOW_CONF)\n      add(f, 'low_confidence', 'warning', 'Model confidence for ' + f + ' is low (' + c + ')');\n  }\n}\n\nconst errCount = errors.filter(e => e.severity === 'error').length;\nconst warnCount = errors.length - errCount;\nconst lowConf = errors.some(e => e.code === 'LOW_CONFIDENCE');\nconst status = (errCount > 0 || lowConf) ? 'needs_review' : 'completed';\nreturn [{ json: { errors, has_errors: errors.length > 0, error_count: errCount,\n                  warning_count: warnCount, status } }];"
      },

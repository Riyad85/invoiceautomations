      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item;\nconst EXPECTED_KEY = 'CHANGE_ME_API_KEY';   // <-- put your own secret here\nconst allowed = ['pdf','jpg','jpeg','png','tiff','tif','xlsx','xls','csv'];\nconst headers = item.json.headers || {};\nconst bin = item.binary || {};\nconst key = Object.keys(bin)[0];\n\nfunction uuid() {\n  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => {\n    const r = Math.random() * 16 | 0;\n    return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);\n  });\n}\n\nlet error = null, statusCode = 400;\nif (headers['apikey'] !== EXPECTED_KEY) { error = 'Unauthorized'; statusCode = 401; }\nelse if (!key) { error = 'No file received. Send multipart/form-data with a file field.'; }\n\nlet filename = '', ext = '';\nif (!error) {\n  filename = bin[key].fileName || 'upload';\n  ext = (filename.split('.').pop() || '').toLowerCase();\n  if (!allowed.includes(ext)) error = 'Unsupported file type: .' + ext;\n}\n\nconst id = uuid();\nconst safe = filename.replace(/[^A-Za-z0-9._-]/g, '_');\nconst fileType = ext === 'jpeg' ? 'jpg' : ext === 'tif' ? 'tiff' : ext;\nconst out = { json: { valid: !error, error, statusCode, document_id: id, filename, file_type: fileType,\n                    storage_path: id + '/' + safe, mime: key ? bin[key].mimeType : null } };\nif (!error) out.binary = { data: bin[key] };\nreturn out;"
      },

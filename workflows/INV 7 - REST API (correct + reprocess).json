      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r && r.id);\nif (!rows.length) return [{ json: { ok: false, status_code: 404, body: { error: 'Document not found' } } }];\nconst d = rows[0];\nif (!['failed','needs_review','completed'].includes(d.status))\n  return [{ json: { ok: false, status_code: 409, body: { error: 'Document is ' + d.status + ' right now. Try again when it finishes.' } } }];\nreturn [{ json: { ok: true, document_id: d.id, filename: d.filename, previous_status: d.status } }];"

    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const b = $json.body || {};\nconst id = String(b.invoice_id || '');\nconst f = (b.fields && typeof b.fields === 'object') ? b.fields : {};\nconst fail = m => ({ json: { valid: false, status_code: 400, body: { error: m } } });\nif (!/^[0-9a-fA-F-]{36}$/.test(id)) return fail('invoice_id is required (uuid)');\nconst changes = {};\nfor (const k of ['invoice_number','supplier_name','customer_name']) if (k in f) { const s = f[k] === null ? '' : String(f[k]).trim(); changes[k] = s === '' ? null : s; }\nfor (const k of ['subtotal','tax','total']) if (k in f) {\n  if (f[k] === null || f[k] === '') changes[k] = null;\n  else { const n = Number(f[k]); if (!Number.isFinite(n)) return fail(k + ' must be a number'); changes[k] = n; } }\nif ('invoice_date' in f) { const d = f.invoice_date;\n  if (d === null || d === '') changes.invoice_date = null;\n  else if (/^\\d{4}-\\d{2}-\\d{2}$/.test(d) && !isNaN(Date.parse(d))) changes.invoice_date = d;\n  else return fail('invoice_date must be YYYY-MM-DD'); }\nif ('currency' in f) { const c = f.currency;\n  if (c === null || c === '') changes.currency = null;\n  else if (/^[A-Za-z]{3}$/.test(c)) changes.currency = c.toUpperCase();\n  else return fail('currency must be a 3-letter code'); }\nif (!Object.keys(changes).length) return fail('No editable fields supplied');\nreturn { json: { valid: true, invoice_id: id, changes } };"
      },

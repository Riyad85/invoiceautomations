    {
      "parameters": {
        "jsCode": "const v = $('Correct Validate').first().json;\nconst rows = $input.all().map(i => i.json).filter(r => r && r.id);\nif (!rows.length) return [{ json: { ok: false, status_code: 404, body: { error: 'Invoice not found' } } }];\nconst inv = rows[0];\nconst corrections = [], patch = {};\nconst conf = Object.assign({}, inv.confidence || {});\nfor (const [f, nv] of Object.entries(v.changes)) {\n  const ov = inv[f];\n  const same = (ov === null || ov === undefined) ? (nv === null) : (nv !== null && (String(ov) === String(nv) || Number(ov) === nv));\n  if (same) continue;\n  patch[f] = nv; conf[f] = 1;   // a human confirmed this value\n  corrections.push({ invoice_id: inv.id, field: f, old_value: (ov === null || ov === undefined) ? null : String(ov), new_value: nv === null ? null : String(nv) });\n}\nif (!corrections.length) return [{ json: { ok: false, status_code: 200, body: { message: 'No changes: values already match' } } }];\npatch.confidence = conf; patch.needs_review = false;\nreturn [{ json: { ok: true, invoice_id: inv.id, document_id: inv.document_id, patch, corrections } }];"
      },

      "parameters": {
        "jsCode": "const vals = $json.embedding && $json.embedding.values;\nif (!Array.isArray(vals) || vals.length === 0) throw new Error('Embedding model returned no vector');\nconst src = $('Build Embedding Input').first().json;\nreturn [{ json: { dims: vals.length, body: { vectors: [{ id: src.doc_id, values: vals, metadata: src.metadata }] } } }];"

    {
      "parameters": {
        "jsCode": "const doc = $('Get Document').first().json;\nconst inv = $('Get Invoice').first().json || {};\nconst txt = (($('Get Text').first().json || {}).full_text || '').trim();\nif (!txt && !inv.id) return [{ json: { ok: false, error: { message: 'Nothing to embed (no text and no invoice data)' } } }];\nconst head = [\n  inv.invoice_number ? 'Invoice ' + inv.invoice_number : 'Document ' + doc.filename,\n  inv.supplier_name ? 'from ' + inv.supplier_name : null,\n  inv.customer_name ? 'to ' + inv.customer_name : null,\n  inv.invoice_date ? 'dated ' + inv.invoice_date : null,\n  inv.total !== null && inv.total !== undefined ? 'total ' + inv.total + (inv.currency ? ' ' + inv.currency : '') : null\n].filter(Boolean).join(' ');\nconst input_text = (head + '.\\n' + txt).slice(0, 6000);\nconst meta = { document_id: doc.id, filename: doc.filename, file_type: doc.file_type, status: doc.status,\n  invoice_number: inv.invoice_number, supplier_name: inv.supplier_name, customer_name: inv.customer_name,\n  invoice_date: inv.invoice_date, currency: inv.currency, total: inv.total === null || inv.total === undefined ? null : Number(inv.total),\n  summary: head.slice(0, 300) };\nObject.keys(meta).forEach(k => { if (meta[k] === null || meta[k] === undefined) delete meta[k]; });  // Pinecone rejects nulls\nreturn [{ json: { ok: true, input_text, metadata: meta, doc_id: doc.id } }];"
      },

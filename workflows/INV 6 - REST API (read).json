    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const SB = 'https://cqktvuidwccrynrdtstn.supabase.co';\nconst q = $json.query || {};\nconst clean = s => String(s || '').replace(/[^\\p{L}\\p{N}\\s._@-]/gu, '').trim().slice(0, 100);\nconst statuses = ['queued','processing','completed','needs_review','failed'];\nconst limit = Math.min(Math.max(parseInt(q.limit) || 20, 1), 100);\nconst offset = Math.max(parseInt(q.offset) || 0, 0);\nconst isDate = d => /^\\d{4}-\\d{2}-\\d{2}$/.test(d || '');\nlet inv = 'invoices(invoice_number,invoice_date,supplier_name,customer_name,total,currency,needs_review)';\nconst p = [];\nif (statuses.includes(q.status)) p.push('status=eq.' + q.status);\nconst sup = clean(q.supplier);\nif (sup) { inv = inv.replace('invoices(', 'invoices!inner('); p.push('invoices.supplier_name=ilike.*' + encodeURIComponent(sup) + '*'); }\nif (isDate(q.from)) { inv = inv.replace('invoices(', 'invoices!inner('); p.push('invoices.invoice_date=gte.' + q.from); }\nif (isDate(q.to))   { inv = inv.replace('invoices(', 'invoices!inner('); p.push('invoices.invoice_date=lte.' + q.to); }\nlet sel = '*,' + inv;\nconst kw = clean(q.q);\nif (kw) { sel += ',extracted_text!inner(document_id)'; p.push('extracted_text.fts=plfts(simple).' + encodeURIComponent(kw)); }\nconst url = SB + '/rest/v1/documents?select=' + sel + '&' + p.join('&') + '&order=created_at.desc&limit=' + limit + '&offset=' + offset;\nreturn { json: { url } };"
      },
